# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB connection string (required)
DBURL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/iweohun

# Authentication (required)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed browser origins, or * for all.
# Native apps are always allowed.
CORS_ORIGIN=*

# Optional: public URL of this API (used for uploaded file URLs behind a proxy).
# Example: https://api.example.com
PUBLIC_BASE_URL=

# Optional: Cloudinary. When these are placeholders/empty the server stores
# uploads locally in server/uploads and serves them at /uploads.
CLOUD_NAME=
API_KEY=
SECRET_KEY=

# Set to true only when the server sits behind a trusted reverse proxy.
TRUST_PROXY=false
