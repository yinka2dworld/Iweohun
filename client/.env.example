# Optional. Use the API origin only (no /api suffix).
# In Expo Go / web development this can stay empty: the app discovers the
# Metro host and connects to port 3000 automatically.
#
# Production / EAS builds must set this to your deployed HTTPS API.
# Example: EXPO_PUBLIC_API_URL=https://api.iweohun.com
EXPO_PUBLIC_API_URL=
