{
  "expo": {
    "name": "Iweohun",
    "slug": "Iweohun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "iweohun",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.iweohun",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourname.iweohun",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": []
    },
    "extra": {
      "eas": {
        "projectId": "98768076-0022-444e-bbc9-3493f478cb0f"
      }
    },
    "plugins": [
      "expo-background-task",
      "expo-asset",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
