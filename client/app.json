{
  "expo": {
    "name": "Iweohun",
    "slug": "Iweohun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "iweohun",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.iweohun",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourname.iweohun",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/favicon.png",
        "backgroundColor": "#f8f8f8"
      },
      "permissions": []
    },
    "extra": {
      "apiBaseUrl": "",
      "eas": {
        "projectId": "98768076-0022-444e-bbc9-3493f478cb0f"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Iweohun to access your photos so you can upload book covers."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f8f8f8"
        }
      ]
    ]
  }
}